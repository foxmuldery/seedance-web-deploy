ARK_API_KEY=your_volcengine_ark_api_key

SEEDANCE_WEB_USERNAME=tusun
SEEDANCE_WEB_ALLOW_ANY_USERNAME=1
SEEDANCE_WEB_PASSWORD=change_this_password

TOS_ACCESS_KEY_ID=your_tos_access_key_id
TOS_SECRET_ACCESS_KEY=your_tos_secret_access_key
TOS_BUCKET=your_bucket_name
TOS_REGION=cn-beijing
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_PREFIX=seedance-inputs
TOS_REQUEST_TIMEOUT=300

SEEDANCE_REQUEST_TIMEOUT=300
SEEDANCE_WEB_HOST=0.0.0.0
SEEDANCE_WEB_PORT=8080
SEEDANCE_OUTPUT_ROOT=/data/seedance_web_outputs
SEEDANCE_LOG_DIR=/data/seedance_web_logs
SEEDANCE_WEB_CONFIG=/data/seedance_web_config.json
