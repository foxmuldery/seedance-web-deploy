FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV SEEDANCE_WEB_HOST=0.0.0.0
ENV SEEDANCE_WEB_PORT=8080
ENV SEEDANCE_OUTPUT_ROOT=/data/seedance_web_outputs
ENV SEEDANCE_LOG_DIR=/data/seedance_web_logs
ENV SEEDANCE_WEB_CONFIG=/data/seedance_web_config.json

WORKDIR /app

COPY requirements-seedance-web.txt .
RUN pip install --no-cache-dir -r requirements-seedance-web.txt

COPY volcengine_seedance_web.py .

EXPOSE 8080

CMD ["python", "volcengine_seedance_web.py"]
